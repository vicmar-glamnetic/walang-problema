<section class="wp-s wp-team" {{ section.shopify_attributes }}>
  <div class="wp-team__head">
    {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-team__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    <h2 class="wp-hd wp-team__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="wp-team__intro">{{ section.settings.text | escape | newline_to_br }}</p>{%- endif -%}
  </div>
  <div class="wp-team__grid">
    {%- for block in section.blocks -%}
      <article class="wp-member" {{ block.shopify_attributes }}>
        <div class="wp-member__photo">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.name, widths: '400, 600, 800', sizes: '(min-width: 1000px) 380px, 90vw' }}
          {%- endif -%}
        </div>
        <h3 class="wp-hd wp-member__name">{{ block.settings.name | escape }}</h3>
        <p class="wp-member__bio">{{ block.settings.bio | escape | newline_to_br }}</p>
        {%- if block.settings.fun != blank -%}<p class="wp-hand wp-member__fun">{{ block.settings.fun | escape }}</p>{%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Team",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten line", "default": "Walang Problema" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Team" },
    { "type": "textarea", "id": "text", "label": "Intro text" }
  ],
  "blocks": [{
    "type": "member", "name": "Team member",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Name" },
      { "type": "textarea", "id": "bio", "label": "Bio" },
      { "type": "text", "id": "fun", "label": "Fun line (handwritten)" }
    ]
  }],
  "presets": [{ "name": "WP Team" }]
}
{% endschema %}
