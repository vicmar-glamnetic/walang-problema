<section class="wp-s wp-sec wp-best" {{ section.shopify_attributes }}>
  <div class="wp-sec__head">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-sec__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="wp-hd wp-sec__title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="wp-link">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
  <div class="wp-grid">
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      {% render 'wp-product-card', product: product, index: forloop.index0 %}
    {%- else -%}
      <p>Pick a collection to show products here.</p>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Product grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten line", "default": "Paborito ng lahat" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "WP Product grid" }]
}
{% endschema %}
