<footer class="wp-s wp-footer wp-footer--island" {{ section.shopify_attributes }}>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="wp-footer__wave" aria-hidden="true"><path d="M0 30 C240 0 480 60 720 30 C960 0 1200 60 1440 30 L1440 60 L0 60 Z" fill="#1B2421"></path></svg>
  <div class="wp-footer__deco" aria-hidden="true">
    {% render 'wp-palm', class: 'wp-palm wp-palm--foot-l', color: '#0E4D4F' %}
    {% render 'wp-palm', class: 'wp-palm wp-palm--foot-r', color: '#0E4D4F' %}
  </div>
  <div class="wp-footer__grid">
    <div class="wp-footer__brand">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: height: 168 | image_tag: height: 56, alt: shop.name, loading: 'lazy' }}
      {%- else -%}
        <span class="wp-logo__text" style="color:#fff">{{ shop.name | escape }}</span>
      {%- endif -%}
      <p class="wp-footer__tag">{{ section.settings.tagline | escape }}</p>
      {%- if section.settings.sign_off != blank -%}<p class="wp-hand wp-footer__sign">{{ section.settings.sign_off | escape }}</p>{%- endif -%}
    </div>
    <nav class="wp-footer__col wp-footer__col--shop" aria-label="{{ section.settings.shop_heading | escape }}">
      <b class="wp-hd">{{ section.settings.shop_heading | escape }}</b>
      <div class="wp-footer__links">
        {%- for link in linklists[section.settings.shop_menu].links -%}
          {%- if link.type == 'collection_link' or link.type == 'collections_link' or link.type == 'catalog_link' -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endif -%}
        {%- endfor -%}
      </div>
    </nav>
    <nav class="wp-footer__col" aria-label="{{ section.settings.help_heading | escape }}">
      <b class="wp-hd">{{ section.settings.help_heading | escape }}</b>
      {%- if section.settings.about_label != blank -%}<a href="{{ section.settings.about_link | default: routes.root_url }}">{{ section.settings.about_label | escape }}</a>{%- endif -%}
      {%- for link in linklists[section.settings.help_menu].links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
    </nav>
    <div class="wp-footer__col{% if section.settings.social_image != blank %} wp-footer__col--pic{% endif %}">
      <div class="wp-footer__follow">
        <b class="wp-hd">{{ section.settings.social_heading | escape }}</b>
        {%- if section.settings.social_handle != blank -%}<a href="{{ section.settings.instagram | default: '#' }}" target="_blank" rel="noopener">{{ section.settings.social_handle | escape }}</a>{%- endif -%}
        <div class="wp-footer__social">{% render 'wp-social', instagram: section.settings.instagram, facebook: section.settings.facebook %}</div>
      </div>
      {%- if section.settings.social_image != blank -%}
        <a class="wp-footer__pic" href="{{ section.settings.instagram | default: '#' }}" target="_blank" rel="noopener" aria-label="{{ section.settings.social_heading | escape }} {{ section.settings.social_handle | escape }}">{{ section.settings.social_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '220px', alt: '' }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="wp-footer__end">
    <div class="wp-footer__payrow">
      <span class="wp-footer__paylabel">{{ section.settings.pay_heading | escape }}</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="wp-footer__pay">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}
        </ul>
      {%- else -%}
        <ul class="wp-footer__pay">
          {%- assign pay_items = section.settings.pay_fallback | split: '·' -%}
          {%- for item in pay_items -%}<li class="wp-footer__pill">{{ item | strip | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="wp-footer__legal">
      <span>{{ section.settings.base_text | escape }}</span>
      {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endfor -%}
    </div>
    {%- if section.settings.credit_text != blank or section.settings.credit_name != blank -%}
      <p class="wp-footer__credit">
        {%- if section.settings.credit_text != blank -%}<span>{{ section.settings.credit_text | escape }}</span>{%- endif -%}
        {%- if section.settings.credit_name != blank -%}<span>{{ section.settings.credit_prefix | escape }} <a href="{{ section.settings.credit_link | default: 'https://vjyanson.com' }}" target="_blank" rel="noopener">{{ section.settings.credit_name | escape }}</a></span>{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</footer>
{% schema %}
{
  "name": "WP Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (use the dark version, it is inverted to white)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Island-inspired lifestyle clothing from the Philippines." },
    { "type": "text", "id": "sign_off", "label": "Handwritten line", "default": "Made for slow mornings in El Nido" },
    { "type": "text", "id": "shop_heading", "label": "Column 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Column 1 menu (collection links are shown)" },
    { "type": "text", "id": "help_heading", "label": "Column 2 heading", "default": "Help" },
    { "type": "text", "id": "about_label", "label": "Column 2 first link label", "default": "Our Story" },
    { "type": "url", "id": "about_link", "label": "Column 2 first link" },
    { "type": "link_list", "id": "help_menu", "label": "Column 2 menu" },
    { "type": "header", "content": "Social" },
    { "type": "text", "id": "social_heading", "label": "Heading", "default": "Follow us" },
    { "type": "text", "id": "social_handle", "label": "Handle", "default": "@walangproblemabrand" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    { "type": "url", "id": "facebook", "label": "Facebook link" },
    { "type": "image_picker", "id": "social_image", "label": "Photo next to Follow us" },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "pay_heading", "label": "Payments label", "default": "We accept" },
    { "type": "text", "id": "pay_fallback", "label": "Text shown until payment methods are set up", "default": "[YOUR PAYMENT METHODS]", "info": "Separate with ·" },
    { "type": "text", "id": "base_text", "label": "Bottom line", "default": "Concept design by VJ Yanson for Walang Problema. Product photos to be supplied by the brand." },
    { "type": "text", "id": "credit_text", "label": "Photo credit (empty hides it)" },
    { "type": "text", "id": "credit_prefix", "label": "Site credit text", "default": "Powered by" },
    { "type": "text", "id": "credit_name", "label": "Site credit name", "default": "vjyanson" },
    { "type": "url", "id": "credit_link", "label": "Site credit link" }
  ]
}
{% endschema %}
