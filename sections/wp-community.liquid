<section class="wp-s wp-sec wp-comm" {{ section.shopify_attributes }}>
  <div class="wp-sec__head wp-comm__head">
    <h2 class="wp-hd wp-sec__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link | default: '#top' }}" class="wp-link">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
  <div class="wp-comm__grid">
    {%- for block in section.blocks -%}
      <div class="wp-tile{% if block.settings.image != blank %} wp-tile--photo{% endif %}" style="background: {{ block.settings.bg }}; color: {{ block.settings.fg }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 1200px) 300px, 50vw', alt: block.settings.label }}{%- else -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Community grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "#WalangProblema" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow us on Instagram and Facebook" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [{
    "type": "tile", "name": "Tile",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "label", "label": "Label (shown when there is no photo, used as alt text when there is)", "default": "Customer photo" },
      { "type": "color", "id": "bg", "label": "Background", "default": "#F7C873" },
      { "type": "color", "id": "fg", "label": "Text", "default": "#1B2421" }
    ]
  }],
  "presets": [{ "name": "WP Community grid" }]
}
{% endschema %}
