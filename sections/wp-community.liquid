<section class="wp-s wp-sec wp-comm{% if section.settings.layout == 'mosaic' %} wp-comm--mosaic{% endif %}" {{ section.shopify_attributes }}>
  <div class="wp-sec__head wp-comm__head">
    <h2 class="wp-hd wp-sec__title">{{ section.settings.heading | escape }}</h2>
    <div class="wp-comm__follow">
      {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link | default: '#top' }}" class="wp-link" target="_blank" rel="noopener">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="wp-soc" target="_blank" rel="noopener" aria-label="{{ shop.name | escape }} on Instagram"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"></circle></svg></a>
      {%- endif -%}
      {%- if section.settings.facebook != blank -%}
        <a href="{{ section.settings.facebook }}" class="wp-soc" target="_blank" rel="noopener" aria-label="{{ shop.name | escape }} on Facebook"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.6 21.5v-8.2h2.8l.5-3.4h-3.3V7.8c0-1 .5-1.8 1.9-1.8h1.5V3.1c-.5-.1-1.4-.2-2.3-.2-2.7 0-4.5 1.6-4.5 4.5v2.5H7.3v3.4h2.9v8.2z"></path></svg></a>
      {%- endif -%}
    </div>
  </div>
  <div class="wp-comm__grid">
    {%- for block in section.blocks -%}
      <div class="wp-tile{% if block.settings.image != blank %} wp-tile--photo{% endif %}" {% unless section.settings.layout == 'mosaic' and block.settings.image != blank %}style="background: {{ block.settings.bg }}; color: {{ block.settings.fg }}"{% endunless %} {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '300, 500, 700, 1000, 1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: block.settings.label }}{%- else -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Community grid",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "polaroids", "options": [{ "value": "polaroids", "label": "Tilted polaroids" }, { "value": "mosaic", "label": "Mosaic (first photo large)" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#WalangProblema" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Follow us on Instagram and Facebook" },
    { "type": "url", "id": "link", "label": "Instagram link" },
    { "type": "url", "id": "facebook", "label": "Facebook link" }
  ],
  "blocks": [{
    "type": "tile", "name": "Tile",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "label", "label": "Label (shown when there is no photo, used as alt text when there is)", "default": "Customer photo" },
      { "type": "color", "id": "bg", "label": "Background", "default": "#F7C873" },
      { "type": "color", "id": "fg", "label": "Text", "default": "#1B2421" }
    ]
  }],
  "presets": [{ "name": "WP Community grid" }]
}
{% endschema %}
