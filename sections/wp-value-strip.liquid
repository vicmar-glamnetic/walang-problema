<div class="wp-s wp-strip" {{ section.shopify_attributes }}>
  <div class="wp-strip__in">
    {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "WP Value strip",
  "blocks": [{ "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Cotton comfort" }] }],
  "presets": [{ "name": "WP Value strip", "blocks": [{ "type": "item", "settings": { "text": "Cotton comfort" } }, { "type": "item", "settings": { "text": "Island-inspired designs" } }, { "type": "item", "settings": { "text": "Secure online checkout" } }, { "type": "item", "settings": { "text": "Made for island living" } }] }]
}
{% endschema %}
