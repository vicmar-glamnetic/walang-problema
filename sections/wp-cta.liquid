<section class="wp-s wp-cta" {{ section.shopify_attributes }}>
  <div class="wp-cta__panel">
  {% render 'wp-palm', class: 'wp-palm wp-palm--cta-l', color: '#2A8C8C' %}
  {% render 'wp-palm', class: 'wp-palm wp-palm--cta-r', color: '#2A8C8C' %}
  {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-cta__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
  <h2 class="wp-hd wp-cta__title">{{ section.settings.heading | escape }}</h2>
  <div class="wp-cta__btns">
    {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="wp-btn wp-btn--gold">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.root_url }}" class="wp-btn wp-btn--ghost">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
  </div>
  </div>
</section>
{% schema %}
{
  "name": "WP Call to action",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for island life?" },
    { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button 1 link" },
    { "type": "text", "id": "button2_label", "label": "Button 2 label", "default": "Get in touch" },
    { "type": "url", "id": "button2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "WP Call to action" }]
}
{% endschema %}
