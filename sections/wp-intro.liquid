<section class="wp-s wp-intro" {{ section.shopify_attributes }}>
  {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-intro__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
  <h2 class="wp-hd wp-intro__title">{{ section.settings.heading | escape }}</h2>
  <p class="wp-intro__text">{{ section.settings.text | escape | newline_to_br }}</p>
</section>
{% schema %}
{
  "name": "WP Centered text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Walang Problema lifestyle" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We believe the Walang Problema lifestyle can help you increase happiness, reduce stress and live life to the fullest. Every tee, cap and bag we make is a little reminder to take it easy, wherever your island is." }
  ],
  "presets": [{ "name": "WP Centered text" }]
}
{% endschema %}
