<section class="wp-s wp-rel" {{ section.shopify_attributes }}>
  <h2 class="wp-hd wp-rel__title">{{ section.settings.heading | escape }}</h2>
  <div class="wp-grid">
    {%- assign shown = 0 -%}
    {%- for item in section.settings.collection.products -%}
      {%- if item.id != product.id and shown < section.settings.limit -%}
        {%- assign card_index = shown | plus: 1 -%}{% render 'wp-product-card', product: item, index: card_index %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the island look" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "WP Related products" }]
}
{% endschema %}
