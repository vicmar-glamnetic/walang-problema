{%- if section.settings.variant == 'wide' -%}
<section class="wp-s wp-wide" id="top" {{ section.shopify_attributes }}>
  {%- if section.settings.image != blank -%}
    <div class="wp-wide__photo">
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 640px)" srcset="{{ section.settings.image_mobile | image_url: width: 500 }} 500w, {{ section.settings.image_mobile | image_url: width: 800 }} 800w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.title }}
      </picture>
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="wp-wave" aria-hidden="true"><path d="M0 30 C240 0 480 60 720 30 C960 0 1200 60 1440 30 L1440 60 L0 60 Z" fill="#F4EBDD"></path></svg>
    </div>
  {%- endif -%}
  <div class="wp-wide__in">
    <div class="wp-wide__head">
      {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-hero__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h1 class="wp-hd wp-hero__title">{{ section.settings.title | escape | newline_to_br }}</h1>
    </div>
    <div class="wp-wide__side">
      {%- if section.settings.text != blank -%}<p class="wp-hero__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="wp-hero__btns">
          {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="wp-btn wp-btn--primary">{{ section.settings.button_label | escape }}</a>{%- endif -%}
          {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="wp-btn wp-btn--ghost">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- else -%}
<section class="wp-s wp-hero{% if section.settings.variant == 'story' %} wp-hero--story{% endif %}{% if section.settings.image != blank and section.settings.variant != 'story' %} wp-hero--photo{% endif %}" id="top" {{ section.shopify_attributes }}>
  {%- if section.settings.variant == 'story' or section.settings.image != blank -%}
    {% render 'wp-palm', class: 'wp-palm wp-palm--hero-l', color: '#4B5A3A' %}
    {% render 'wp-palm', class: 'wp-palm wp-palm--hero-r', color: '#0E4D4F' %}
  {%- endif -%}
  <div class="wp-hero__in">
    <div class="wp-hero__copy">
      {%- if section.settings.variant == 'story' -%}
        <nav class="wp-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title | default: section.settings.kicker | escape }}</nav>
      {%- endif -%}
      {%- if section.settings.kicker != blank -%}<p class="wp-hand wp-hero__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h1 class="wp-hd wp-hero__title">{{ section.settings.title | escape | newline_to_br }}</h1>
      {%- if section.settings.text != blank -%}<p class="wp-hero__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="wp-hero__btns">
          {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="wp-btn wp-btn--primary">{{ section.settings.button_label | escape }}</a>{%- endif -%}
          {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="wp-btn wp-btn--ghost">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="wp-hero__art">
      {%- if section.settings.image != blank -%}
        {%- if section.settings.image_2 != blank -%}
          <figure class="wp-polaroid wp-polaroid--back" aria-hidden="true">
            {{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'eager', widths: '300, 500, 700', sizes: '(min-width: 1000px) 300px, 45vw', alt: '' }}
          </figure>
        {%- endif -%}
        {%- if section.settings.sticker != blank -%}<span class="wp-sticker wp-hand">{{ section.settings.sticker | escape }}</span>{%- endif -%}
        <figure class="wp-polaroid">
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400, 600, 900, 1200', sizes: '(min-width: 1000px) 640px, 90vw', alt: section.settings.image.alt | default: section.settings.image_caption }}
          {%- if section.settings.image_caption != blank -%}<figcaption class="wp-hand wp-polaroid__cap">{{ section.settings.image_caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- elsif section.settings.variant == 'story' -%}
        {% render 'wp-art-story' %}
      {%- else -%}
        {% render 'wp-art-hero' %}
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.variant == 'story' or section.settings.image != blank -%}
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="wp-wave" aria-hidden="true"><path d="M0 30 C240 0 480 60 720 30 C960 0 1200 60 1440 30 L1440 60 L0 60 Z" fill="{{ section.settings.wave_color | default: '#F4EBDD' }}"></path></svg>
  {%- endif -%}
</section>
{%- endif -%}
{% schema %}
{
  "name": "WP Hero",
  "settings": [
    { "type": "select", "id": "variant", "label": "Layout", "default": "home", "options": [{ "value": "home", "label": "Home (large)" }, { "value": "wide", "label": "Home (full-width photo)" }, { "value": "story", "label": "Our Story (with breadcrumb)" }] },
    { "type": "text", "id": "kicker", "label": "Handwritten line", "default": "Mabuhay, islander!" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Island Life\nin cotton." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Easy tees, caps and beach gear made for slow mornings, salty air and zero stress. Spread the joy and wear it with pride." },
    { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Shop New Arrivals" },
    { "type": "url", "id": "button_link", "label": "Button 1 link" },
    { "type": "text", "id": "button2_label", "label": "Button 2 label", "default": "Beach Essentials" },
    { "type": "url", "id": "button2_link", "label": "Button 2 link" },
    { "type": "image_picker", "id": "image", "label": "Image (replaces the illustration)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone photo, portrait (full-width layout)" },
    { "type": "text", "id": "image_caption", "label": "Photo caption (handwritten)" },
    { "type": "image_picker", "id": "image_2", "label": "Second photo (small, tucked behind)" },
    { "type": "text", "id": "sticker", "label": "Round sticker text" },
    { "type": "color", "id": "wave_color", "label": "Wave color (match the next section)", "default": "#F4EBDD" }
  ],
  "presets": [{ "name": "WP Hero" }]
}
{% endschema %}
