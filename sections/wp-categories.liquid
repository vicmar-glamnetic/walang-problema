<section class="wp-s wp-sec wp-cats{% if section.settings.layout == 'mosaic' %} wp-cats--mosaic{% endif %}" id="shop" {{ section.shopify_attributes }}>
  <div class="wp-sec__head">
    <h2 class="wp-hd wp-sec__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="wp-link">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
  <div class="wp-cats__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="wp-cat{% if block.settings.image != blank %} wp-cat--photo{% endif %}" {% unless section.settings.layout == 'mosaic' %}style="background: {{ block.settings.bg }}; color: {{ block.settings.fg }}"{% endunless %} {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <span class="wp-cat__photo">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 500, 700, 1200', sizes: '(min-width: 900px) 600px, 50vw', alt: '' }}</span>
          <span class="wp-cat__name">{{ block.settings.title | escape }} <span aria-hidden="true">&rarr;</span></span>
        {%- else -%}
          {% render 'wp-icon', name: block.settings.icon %}
          <span class="wp-cat__name">{{ block.settings.title | escape }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "WP Category tiles",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "cards", "options": [{ "value": "cards", "label": "Colored cards" }, { "value": "mosaic", "label": "Mosaic (two large, three small)" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the island" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all products" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [{
    "type": "tile", "name": "Tile",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Men" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Photo (replaces the icon; white background works best)" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "men", "options": [{ "value": "men", "label": "Men" }, { "value": "women", "label": "Women" }, { "value": "kids", "label": "Kids" }, { "value": "accessories", "label": "Cap" }, { "value": "beach", "label": "Beach umbrella" }] },
      { "type": "color", "id": "bg", "label": "Background", "default": "#2A8C8C" },
      { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" }
    ]
  }],
  "presets": [{ "name": "WP Category tiles" }]
}
{% endschema %}
