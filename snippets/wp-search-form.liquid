{%- comment -%}
  Search bar. Accepts: id (unique input id), class (extra class), placeholder, button (true shows the gold button).
{%- endcomment -%}
<form action="{{ routes.search_url }}" method="get" role="search" class="wp-sbar {{ class }}">
  <label for="{{ id }}" class="wp-sr">Search products</label>
  <svg class="wp-sbar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
  <input id="{{ id }}" class="wp-sbar__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ placeholder | default: 'Search' | escape }}" autocomplete="off" autocapitalize="off" spellcheck="false">
  <input type="hidden" name="type" value="product">
  <input type="hidden" name="options[prefix]" value="last">
  <input type="hidden" name="options[unavailable_products]" value="last">
  {%- if button -%}<button type="submit" class="wp-btn wp-btn--gold wp-sbar__btn">Search</button>{%- endif -%}
</form>
