{%- comment -%}
  Decorative palm frond. Usage: {% render 'wp-palm', class: 'wp-palm wp-palm--tl', color: '#4B5A3A' %}
{%- endcomment -%}
{%- assign c = color | default: '#4B5A3A' -%}
<svg class="{{ class }}" viewBox="0 0 220 220" aria-hidden="true" focusable="false"><g transform="translate(14 206) rotate(-45)" fill="{{ c }}"><path d="M0 0 H232" stroke="{{ c }}" stroke-width="5" stroke-linecap="round" fill="none"></path>
{%- for i in (1..9) -%}
  {%- assign pos = i | times: 24 -%}
  {%- assign len = 12 | minus: i | times: 9 -%}
  {%- assign a = len | times: 3 | divided_by: 10 -%}
  {%- assign b = len | times: 7 | divided_by: 10 -%}
<path transform="translate({{ pos }} 0) rotate(-52)" d="M0 0 C{{ a }} -11 {{ b }} -11 {{ len }} 0 C{{ b }} 5 {{ a }} 5 0 0Z"></path><path transform="translate({{ pos }} 0) rotate(52)" d="M0 0 C{{ a }} 11 {{ b }} 11 {{ len }} 0 C{{ b }} -5 {{ a }} -5 0 0Z"></path>
{%- endfor -%}
</g></svg>
