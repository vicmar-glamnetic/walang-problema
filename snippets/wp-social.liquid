{%- comment -%} Instagram and Facebook buttons. Accepts: instagram, facebook (URLs). {%- endcomment -%}
{%- if instagram != blank -%}
  <a href="{{ instagram }}" class="wp-soc" target="_blank" rel="noopener" aria-label="{{ shop.name | escape }} on Instagram"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"></circle></svg></a>
{%- endif -%}
{%- if facebook != blank -%}
  <a href="{{ facebook }}" class="wp-soc" target="_blank" rel="noopener" aria-label="{{ shop.name | escape }} on Facebook"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.6 21.5v-8.2h2.8l.5-3.4h-3.3V7.8c0-1 .5-1.8 1.9-1.8h1.5V3.1c-.5-.1-1.4-.2-2.3-.2-2.7 0-4.5 1.6-4.5 4.5v2.5H7.3v3.4h2.9v8.2z"></path></svg></a>
{%- endif -%}
